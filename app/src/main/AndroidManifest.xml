<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Сеть -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Foreground-сервис VPN -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!--
      Тип FGS — specialUse: значение "vpn" для foregroundServiceType появилось
      только в API 36, а проект компилируется под compileSdk 35 (нет ни атрибута
      в AAPT, ни константы ServiceInfo). Разрешение ниже ОБЯЗАТЕЛЬНО: без него
      startForeground с этим типом бросает SecurityException и туннель не встаёт.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Постоянное уведомление (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Список установленных приложений для per-app маршрутизации (split-tunnel) -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <!-- Самообновление: установка скачанного APK через системный установщик -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".InfinityApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.InfinityConnect">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.InfinityConnect">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            VPN-сервис (туннель поверх Xray/Hysteria2).

            android:process=":vpn" — ОБЯЗАТЕЛЬНО, не оптимизация. Ядра Xray
            (libv2ray) и Hysteria2 (libhysteria2) — два независимых
            gomobile/Go-рантайма. Два Go-рантайма не сосуществуют в одном
            адресном пространстве: каждый процессно перехватывает сигналы
            (sigaction) и заводит свой TLS, из-за чего cgo-переход одного ядра
            уходит в чужой рантайм. Итог — падение процесса
            ("unexpected return pc for runtime.cgocallback" / "unknown caller
            pc") при запуске ВТОРОГО ядра за жизнь процесса, в любом порядке.

            Отдельный процесс позволяет завершать его при смене движка
            (InfinityVpnService.stopTunnel → exitProcessIfEngineChanges), не
            трогая UI: новое ядро всегда стартует в чистом рантайме.
        -->
        <service
            android:name=".vpn.InfinityVpnService"
            android:process=":vpn"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:foregroundServiceType="specialUse">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="VPN-туннель Infinity Connect" />
        </service>

        <!-- Выдача скачанного APK-обновления системному установщику -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>
