    <string name="ping_method_proxy_get_desc">HTTP GET to the test URL through the server protocol itself (Xray core): full response. The most accurate, but values are higher. Falls back to TCP for Hysteria2.</string>
    <string name="ping_method_proxy_head">Via proxy (HEAD)</string>
    <string name="ping_method_proxy_head_desc">HTTP HEAD to the test URL through the server protocol: headers only, no body. Lighter than GET, values slightly lower. Falls back to TCP for Hysteria2.</string>
    <string name="ping_method_tcp">TCP</string>
    <string name="ping_method_tcp_desc">TCP connection time to the server (host:port). Pure latency to the node, without HTTP/TLS.</string>
    <string name="ping_method_icmp">ICMP</string>
