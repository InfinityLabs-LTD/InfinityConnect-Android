<?xml version="1.0" encoding="utf-8"?>
<!--
  Иконка плитки быстрых настроек — щит (классический знак VPN/защиты).

  ПОЧЕМУ НЕ ЛОГОТИП «I». Логотип бренда — буква «I» с горизонтальными долями,
  и в монохроме на 24dp это ровно форма текстового курсора (I-beam): проверено
  на устройстве, в шторке значок читался как курсор из редактора, а не как знак
  VPN. Узнаваемым логотип делают цвет, градиент и объём лепестков — всё то, что
  плитка отбрасывает, заливая фигуру одним цветом. Щит же на этом размере
  однозначен и сразу сообщает, о чём плитка.

  Рисуем сплошной силуэт без внутренних деталей: систему интересует только
  форма — она красит значок сама (серым, когда плитка неактивна, акцентным
  цветом, когда активна). Тонкие внутренние линии на 24dp всё равно замылились
  бы, поэтому их здесь нет.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!--
      Щит: от верхней кромки плечи расходятся вниз и сходятся в скруглённое
      остриё. Верх слегка скруглён (радиус 1.4), чтобы силуэт не выглядел
      обрубленным, низ — плавная дуга, как у классического герба.
    -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M12,2.2 L19.2,5.1 A1.4,1.4 0 0,1 20,6.4 L20,11.4 C20,16.2 16.8,20.2 12.4,21.7 A1.2,1.2 0 0,1 11.6,21.7 C7.2,20.2 4,16.2 4,11.4 L4,6.4 A1.4,1.4 0 0,1 4.8,5.1 Z" />
</vector>
