*.iml
.gradle/
/local.properties
/.idea/
.DS_Store
build/
/captures
.externalNativeBuild
.cxx
local.properties

# Собранные/скачанные AAR движков — не коммитим бинарники
/app/libs/*.aar

# Подписной keystore — секрет, не коммитим
/app/release.keystore
*.keystore
*.jks

# Готовые APK — не коммитим (большие бинарники)
/*.apk

# Служебный каталог Kotlin-компилятора (сессии сборки)
/.kotlin/

# sources.jar рядом с AAR — тоже артефакт сборки gomobile
/app/libs/*-sources.jar

# go.sum обёртки Hysteria2 — генерируется build-aar.sh под временные replace
# (пути к локальным копиям hysteria и патченного x/mobile), у каждой машины свой.
/hysteria2-mobile/go.sum
/hysteria2-mobile/go.mod.orig
/hysteria2-mobile/tools.go
